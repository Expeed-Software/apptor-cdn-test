            "styles": { "min-width": "220px", "flex": "1" },
            "slots": {
              "default": [
                { "name": "genre-fiction-text", "type": "text", "props": { "text": "From new releases to well-worn classics, our fiction wall is the first thing you see walking in." } }
              ]
            }
          },
          {
            "name": "genre-nonfiction",
            "type": "card",
            "props": { "title": "Nonfiction", "subtitle": "History, biography, and essays" },
