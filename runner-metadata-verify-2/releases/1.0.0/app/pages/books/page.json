            "slots": {
              "default": [
                { "name": "genre-nonfiction-text", "type": "text", "props": { "text": "Deep dives into history and science, alongside memoirs and essay collections our staff can't stop talking about." } }
              ]
            }
          },
          {
            "name": "genre-kids",
            "type": "card",
            "props": { "title": "Children's", "subtitle": "Picture books through middle grade" },
            "styles": { "min-width": "220px", "flex": "1" },
            "slots": {
              "default": [
                { "name": "genre-kids-text", "type": "text", "props": { "text": "A dedicated reading nook and a shelf of picture books, early readers, and middle-grade favorites." } }
              ]
            }
          },
          {
            "name": "genre-poetry",
            "type": "card",
            "props": { "title": "Poetry", "subtitle": "New voices and old favorites" },
            "styles": { "min-width": "220px", "flex": "1" },
            "slots": {
              "default": [
                { "name": "genre-poetry-text", "type": "text", "props": { "text": "A small but mighty poetry section, refreshed after every open mic night." } }
              ]
            }
          },
          {
            "name": "genre-local",
            "type": "card",
            "props": { "title": "Local Authors", "subtitle": "Signed copies from writers in town" },
            "styles": { "min-width": "220px", "flex": "1" },
            "slots": {
              "default": [
                { "name": "genre-local-text", "type": "text", "props": { "text": "We keep a standing table for local authors — ask at the counter about our next signing event." } }
              ]
            }
