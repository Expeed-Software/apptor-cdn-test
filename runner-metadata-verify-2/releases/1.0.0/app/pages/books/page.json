      "slots": {
        "default": [
          {
            "name": "books-title",
            "type": "text",
            "props": { "text": "What We Carry" },
            "styles": {
              "--canvas-text-text-color": "#2d4a3a",
              "--canvas-text-font-size": "40px",
              "--canvas-text-font-weight": "700",
              "--canvas-text-text-align": "center"
