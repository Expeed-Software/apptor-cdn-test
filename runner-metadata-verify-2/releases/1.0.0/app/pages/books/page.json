                      "edges": [{ "id": "e1", "source": "start", "target": "go" }]
                    }
                  }
                },
                {
                  "name": "nav-about",
                  "type": "button",
                  "props": { "label": "About" },
                  "styles": { "--canvas-button-text-color": "#f5efe3" },
