            "styles": { "display": "flex", "flex-direction": "row", "gap": "8px" },
            "slots": {
              "default": [
                {
                  "name": "nav-home",
                  "type": "button",
                  "props": { "label": "Home" },
                  "styles": { "--canvas-button-text-color": "#f5efe3" },
                  "events": {
                    "onClick": {
                      "nodes": [
                        { "id": "start", "data": { "name": "start", "type": "start", "params": {} } },
                        { "id": "go", "data": { "name": "go", "type": "navigate", "params": { "urlOrPath": "/" } } }
