          },
          {
            "name": "books-sub",
            "type": "text",
            "props": { "text": "Every section hand-picked and re-stocked weekly." },
            "styles": { "--canvas-text-text-color": "#4b4033", "--canvas-text-font-size": "16px", "--canvas-text-text-align": "center" }
          }
        ]
      }
    },
