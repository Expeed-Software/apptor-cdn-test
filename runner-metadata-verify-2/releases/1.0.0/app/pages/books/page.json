{
  "components": [
    {
      "name": "nav-bar",
      "type": "container",
      "styles": {
        "display": "flex",
        "flex-direction": "row",
        "align-items": "center",
        "justify-content": "space-between",
        "padding": "20px 40px",
        "--canvas-container-background": "#2d4a3a"
      },
      "slots": {
        "default": [
          {
            "name": "brand",
            "type": "text",
            "props": { "text": "Lantern & Leaf" },
            "styles": {
              "--canvas-text-text-color": "#f5efe3",
              "--canvas-text-font-size": "22px",
              "--canvas-text-font-weight": "700"
            }
          },
          {
            "name": "nav-links",
