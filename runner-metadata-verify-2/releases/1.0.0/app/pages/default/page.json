          {
            "name": "highlights-title",
            "type": "text",
            "props": { "text": "This week at Lantern & Leaf" },
            "styles": {
              "--canvas-text-text-color": "#2d4a3a",
              "--canvas-text-font-size": "28px",
              "--canvas-text-font-weight": "700"
            }
          },
          {
            "name": "highlights-grid",
            "type": "container",
            "styles": { "display": "flex", "flex-direction": "row", "flex-wrap": "wrap", "gap": "20px" },
            "slots": {
              "default": [
