                  "name": "highlight-picks",
                  "type": "card",
                  "props": { "title": "Curated Picks", "subtitle": "New arrivals on the front table" },
                  "styles": { "min-width": "220px", "flex": "1" },
                  "slots": {
                    "default": [
                      {
                        "name": "highlight-picks-text",
                        "type": "text",
                        "props": { "text": "Staff picks change every Monday, chosen by whoever's reading something they can't put down." }
                      }
                    ]
                  }
                },
                {
                  "name": "highlight-menu",
                  "type": "card",
                  "props": { "title": "Cafe Menu", "subtitle": "Coffee, tea, and fresh-baked pastries" },
                  "styles": { "min-width": "220px", "flex": "1" },
                  "slots": {
                    "default": [
                      {
                        "name": "highlight-menu-text",
                        "type": "text",
                        "props": { "text": "Pour-over coffee, loose-leaf tea, and a rotating pastry case from our in-house baker." }
                      }
                    ]
                  }
                },
                {
                  "name": "highlight-events",
                  "type": "card",
                  "props": { "title": "Weekly Events", "subtitle": "Book club, story hour, open mic" },
                  "styles": { "min-width": "220px", "flex": "1" },
                  "slots": {
                    "default": [
                      {
                        "name": "highlight-events-text",
                        "type": "text",
                        "props": { "text": "Tuesday book club, Saturday morning story hour for kids, and open mic poetry on the last Friday of the month." }
                      }
                    ]
                  }
                }
              ]
            }
          }
