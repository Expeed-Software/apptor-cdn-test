    {
      "name": "hero",
      "type": "container",
      "styles": {
        "display": "flex",
        "flex-direction": "column",
        "align-items": "center",
        "justify-content": "center",
        "gap": "16px",
        "padding": "72px 24px",
        "--canvas-container-background": "#f5efe3"
      },
      "slots": {
        "default": [
          {
            "name": "hero-eyebrow",
            "type": "text",
            "props": { "text": "INDEPENDENT BOOKSTORE & CAFE · EST. 2019" },
            "styles": {
              "--canvas-text-text-color": "#8b5e3c",
              "--canvas-text-font-size": "13px",
              "--canvas-text-font-weight": "600",
              "--canvas-text-text-align": "center"
            }
          },
          {
            "name": "hero-title",
            "type": "text",
            "props": { "text": "Lantern & Leaf" },
            "styles": {
              "--canvas-text-text-color": "#2d4a3a",
              "--canvas-text-font-size": "48px",
              "--canvas-text-font-weight": "700",
              "--canvas-text-text-align": "center"
            }
          },
          {
            "name": "hero-tagline",
            "type": "text",
            "props": { "text": "A cozy corner for readers and coffee lovers — curated books, fresh pastries, and a warm place to sit and stay a while." },
            "styles": {
              "--canvas-text-text-color": "#4b4033",
              "--canvas-text-font-size": "18px",
              "--canvas-text-text-align": "center"
            }
          },
          {
            "name": "hero-cta",
            "type": "button",
            "props": { "label": "Browse Our Books" },
            "styles": { "--canvas-button-background": "#2d4a3a", "--canvas-button-text-color": "#f5efe3" },
            "events": {
              "onClick": {
                "nodes": [
                  { "id": "start", "data": { "name": "start", "type": "start", "params": {} } },
                  { "id": "go", "data": { "name": "go", "type": "navigate", "params": { "urlOrPath": "/books" } } }
                ],
                "edges": [{ "id": "e1", "source": "start", "target": "go" }]
              }
            }
          }
        ]
      }
    },
    { "name": "divider-1", "type": "divider" },
    {
      "name": "intro-section",
      "type": "container",
      "styles": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "12px",
        "padding": "48px 64px",
        "--canvas-container-background": "#ffffff"
      },
      "slots": {
        "default": [
          {
            "name": "intro-title",
            "type": "text",
            "props": { "text": "Why stop by" },
            "styles": {
              "--canvas-text-text-color": "#2d4a3a",
              "--canvas-text-font-size": "28px",
              "--canvas-text-font-weight": "700"
            }
          },
          {
            "name": "intro-text",
            "type": "text",
            "props": { "text": "We're a family-run bookstore with a full espresso bar in the back corner. Every shelf is hand-picked by our staff, every pastry is baked that morning, and every table is yours for as long as you need it." },
            "styles": { "--canvas-text-text-color": "#4b4033", "--canvas-text-font-size": "16px" }
          }
        ]
      }
    },
    { "name": "divider-2", "type": "divider" },
    {
      "name": "highlights-section",
      "type": "container",
      "styles": {
        "display": "flex",
