        { "name": "story-image", "type": "image", "styleGroup": "story-image", "props": { "src": "https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=900&q=80", "alt": "Founders in the first Meridian office", "objectFit": "cover" }, "styles": { "width": "100%", "height": "320px", "border-radius": "10px" }, "slots": [] },
        { "name": "story-p1", "type": "text", "props": { "text": "Meridian started on the third floor of a converted print works, with twelve desks and Wi-Fi that dropped every afternoon. Priya and Owen were both freelancing and tired of working from cafes." }, "styles": { "margin-top": "16px" }, "slots": [] },
        { "name": "story-p2", "type": "text", "props": { "text": "Eight years later, we run three floors across three neighborhoods, but the standard hasn't moved: real desks, real quiet, and a network that never drops mid-call." }, "styles": {}, "slots": [] },
        { "name": "story-p3", "type": "text", "props": { "text": "Riverside opened in 2020, Uptown in 2023. Same layout philosophy in every location — quiet floor up top, cafe energy on the ground floor, meeting rooms you can actually book without a fight." }, "styles": {}, "slots": [] }
      ]
    },
